{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "senpainet-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "senpainet-emu",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:emu"
      ],
      "port": 3001
    },
    {
      "name": "senpainet-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3002",
        "--directory",
        "out"
      ],
      "port": 3002
    }
  ]
}