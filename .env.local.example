# Firebase（プロジェクト senpainet-console の Web アプリ設定。Firebase コンソール > プロジェクトの設定 > マイアプリ）
# これらは公開されても問題ない値（データはセキュリティルールで守る）。サービスアカウントの鍵はここに書かない。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=senpainet-console.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=senpainet-console
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=senpainet-console.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=898586525680
NEXT_PUBLIC_FIREBASE_APP_ID=1:898586525680:web:66416de3cecd569739a735

# サイトのURL（確認メール・パスワード再設定メールのリンク先）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 学校ドメインのみ登録を許可する場合（例: tguiss.ed.jp）。空なら制限なし。
# 本番の制限は Firestore の config/qaSettings.allowedEmailDomain でもかけること（README 参照）。
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=
